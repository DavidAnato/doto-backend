# ─── DOTO+ / SantéBénin+ — Backend Django ───────────────────────────────
DJANGO_SECRET_KEY=change-me-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Clé de chiffrement des tokens DotoCard (Fernet). Générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CARD_TOKEN_KEY=

# Durées de session JWT (SimpleJWT)
# CDC historique : access web ~5 min / mobile ~10 min — trop court pour démos locales.
# Dev/démo : 60 min access ; refresh 7 jours. En prod, resserrer si besoin (ex. 15–30).
# Les fronts tentent un refresh automatique sur 401 ; échec → déconnexion + toast.
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7

# Sécurité connexion
LOGIN_MAX_ATTEMPTS=3
LOGIN_LOCKOUT_MINUTES=15
PATIENT_PIN_MAX_ATTEMPTS=5

# ─── OTP SMS (SmsProvider) ─────────────────────────────────────────────
# mock = aucun SMS réel, code fixe DEMO_OTP_CODE (dev + smoke tests)
# twilio = stub réel (nécessite TWILIO_*)
SMS_PROVIDER=mock
DEMO_OTP_CODE=000000
OTP_TTL_SECONDS=300
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550100

# ─── ANIP (AnipClient) ─────────────────────────────────────────────────
# mock = accepte tout NPI raisonnable ; http = appel REST (ANIP_BASE_URL)
ANIP_PROVIDER=mock
# ANIP_BASE_URL=https://api.anip.bj/v1
# ANIP_API_KEY=

# ─── Consentement accès + Push Expo ─────────────────────────────────────
ACCESS_REQUEST_TTL_MINUTES=2
ACCESS_GRANT_TTL_MINUTES=60
ACCESS_EMERGENCY_GRANT_TTL_MINUTES=30
# EXPO_ACCESS_TOKEN=   # laisser vide = push mock (logs) ; renseigner pour push réel

# CORS (frontends)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://localhost:19006

# PostgreSQL (optionnel — sinon SQLite en dev).
# Render / prod : DATABASE_URL est injecté automatiquement.
# DATABASE_URL=postgres://user:pass@host:5432/doto
# POSTGRES_DB=doto
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Derrière un reverse-proxy (Render)
# DJANGO_BEHIND_PROXY=True
# PUBLIC_API_BASE=https://ton-api.onrender.com
