# ─── DOTO+ - Backend Django ─────────────────────────────────────────────
# Fichier OPTIONNEL. Sans .env : SQLite + DEBUG + CORS/CSRF ouverts + OTP mock.
# Utile surtout pour override prod (Render) ou secrets.

# DJANGO_SECRET_KEY=change-me-en-production
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=*

# CARD_TOKEN_KEY=   # optionnel - dérivé de SECRET_KEY si vide
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ACCESS_TOKEN_MINUTES=60
# REFRESH_TOKEN_DAYS=7

# SMS_PROVIDER=mock
# DEMO_OTP_CODE=00000

# CORS_ALLOW_ALL_ORIGINS=True
# OPEN_CSRF=True

# Render / Postgres (sinon SQLite) :
# DATABASE_URL=postgres://...
# DJANGO_BEHIND_PROXY=True
# DJANGO_DEBUG=False
# PUBLIC_API_BASE=https://ton-api.onrender.com

# OCR (Render : Tesseract + paquets apt Native Environment)
# DOTO_OCR_ENGINE=tesseract
# DOTO_OCR_LANG=fra+eng
# DOTO_OCR_TIMEOUT=25
# TESSERACT_CMD=/usr/bin/tesseract
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
